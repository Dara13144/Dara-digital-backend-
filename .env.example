# Server Environment
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com

# Security & JWT
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
DATABASE_URL=postgresql://postgres.xxxx:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567
TELEGRAM_BOT_USERNAME=YourStoreBot
TELEGRAM_ADMIN_CHAT_ID=123456789
TELEGRAM_MINI_APP_URL=https://t.me/YourStoreBot/app

# ABA PayWay Payment Gateway Integration
ABA_ENVIRONMENT=sandbox
# sandbox base: https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
# production base: https://checkout.payway.com.kh/api/payment-gateway/v1/payments/purchase
ABA_MERCHANT_ID=ec000000
ABA_API_KEY=your_aba_payway_api_key
ABA_SECRET=your_aba_payway_api_push_secret_key
ABA_RETURN_URL=https://your-domain.com/orders/success
ABA_CANCEL_URL=https://your-domain.com/checkout
ABA_CALLBACK_URL=https://api.your-domain.com/api/payments/aba/callback

# Storage Bucket Names
SUPABASE_BUCKET_PRODUCTS=products
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_DIGITAL_FILES=digital-files

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
ADMIN_EMAILS=darazzdev@gmail.com,admin@daradigital.store
